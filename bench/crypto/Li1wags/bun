 primes.mjs


  Generates an array of prime numbers up to a specified limit using the Sieve of Eratosthenes.
  @param {number} limit The upper bound for prime numbers (inclusive).
  @returns {number[]} An array containing all prime numbers up to the limit.
 
function generatePrimesSieve(limit) {
    if (limit  2) return [];

     Create a boolean array isPrime[0...limit] and initialize all entries as true.
     A value in isPrime[i] will finally be false if i is Not a prime, else true.
    const isPrime = new Array(limit + 1).fill(true);
    isPrime[0] = isPrime[1] = false;

     The outer loop runs up to the square root of the limit for efficiency.
    for (let p = 2; p  p = limit; p++) {
         If isPrime[p] is not changed, then it is a prime.
        if (isPrime[p] === true) {
             Update all multiples of p starting from pp (smaller multiples were
             already marked by their own prime factors).
            for (let i = p  p; i = limit; i += p)
                isPrime[i] = false;
        }
    }

     Collect all the numbers that are still marked as true.
    const primes = [];
    for (let p = 2; p = limit; p++) {
        if (isPrime[p]) {
            primes.push(p);
        }
    }

    return primes;
}

 Example usage
const limit = 100;  Find primes up to 100
const primeNumbers = generatePrimesSieve(limit);

console.log(`Prime numbers up to ${limit}`);
console.log(primeNumbers);

 Export the function for potential use in other modules
export { generatePrimesSieve };
